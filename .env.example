# ============================================================================
# Code Companion AI — Environment Variables (Zero-Cost Stack)
# ============================================================================
# Copy this file to .env and fill in your values. Never commit .env to git.

# --- Supabase (https://supabase.com) ---
# Create a new free project at supabase.com, then copy these from
# Project Settings > API.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# --- NVIDIA NIM (https://build.nvidia.com/settings/api-keys) ---
# Free tier: no credit card, ~40 requests/min, ~10k requests/day.
# Models: nemotron-3-ultra-550b-a55b (primary), nemotron-3.5-lightning-30b-a3b (fallback)
NVIDIA_API_KEY="nvapi-YOUR_NVIDIA_API_KEY"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# --- GitHub OAuth App (https://github.com/settings/developers) ---
# Create a New OAuth App. Homepage URL = your production URL.
# Authorization callback URL = https://YOUR_DOMAIN/auth/github/callback
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# --- Application ---
# Public URL of your deployed frontend (used for CORS + OAuth redirects).
# Examples: https://code-companion-ai.pages.dev  or  https://yourdomain.com
APP_URL="https://localhost:8080"

# --- Feature flags ---
NVIDIA_PRIMARY_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
NVIDIA_FALLBACK_MODEL_1="nvidia/nemotron-3.5-lightning-30b-a3b"
NVIDIA_FALLBACK_MODEL_2="openai/gpt-oss-120b"
MAX_ANALYSES_PER_USER_PER_DAY="10"
MAX_GLOBAL_ANALYSES_PER_DAY="200"
ANALYSIS_FILE_CAP="25"
ANALYSIS_KB_CAP="150"
